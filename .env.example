# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medprescribe?schema=public"

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
